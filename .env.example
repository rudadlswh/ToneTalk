# Supabase Shared Pooler connection string. Keep the password server-side.
AI_PROVIDER=gemini
# Application safety limits, NOT Google's free-tier allowance. Provider limits may be lower.
AI_ENABLED=true
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=100
AI_USER_MINUTE_LIMIT=5
AI_GLOBAL_MINUTE_LIMIT=10
AI_MAX_CONCURRENT=2
# Defaults to DATABASE_SCHEMA. For dev/prod sharing one provider project, set BOTH
# to tonetalk_prod AFTER applying the AI usage migration there. Keep limits equal.
# AI_USAGE_SCHEMA=tonetalk_prod
AI_USAGE_SCOPE=primary
GEMINI_MODEL=gemini-3.1-flash-lite
# One server-only key remains supported. For failover, use up to five comma-separated
# keys from different Google Cloud projects; keys in one project share quota.
GEMINI_API_KEY=replace-with-server-only-key
# GEMINI_API_KEYS=primary-project-key,backup-project-key
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres

# Local development uses tonetalk_dev. Set tonetalk_prod only in Vercel Production.
DATABASE_SCHEMA=tonetalk_dev
# Same PC in dev/prod: set this identically in BOTH environments.
# Both DB connections must reach this schema in the same PostgreSQL database.
OLLAMA_LEASE_SCHEMA=tonetalk_prod

# Private Ollama server. Never expose this with NEXT_PUBLIC_.
OLLAMA_BASE_URL=http://192.168.45.140:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=150000

# Set both only when OLLAMA_BASE_URL is protected with HTTP Basic Auth (for example, ngrok).
# OLLAMA_BASIC_AUTH_USERNAME=tonetalk
# OLLAMA_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# All AI routes also have a shared 150s end-to-end request deadline.
# Benchmark before changing models: the installed 1.5b was faster but inaccurate.

# Supabase Auth public configuration (never use a secret/service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# No SINGLE_USER_ID fallback: all app APIs require verified email login.
